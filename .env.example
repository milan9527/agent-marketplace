# Local Docker Compose
POSTGRES_PASSWORD=marketplace-local-only
DB_PORT=5433
API_PORT=8001
WEB_PORT=3000

# Copy relevant backend values into backend/.env for direct Python development.
APP_MODE=demo
DATABASE_URL=sqlite:///./marketplace.db
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# AWS mode uses RDS, Cognito, two AgentCore runtimes, and real Payments APIs.
AWS_REGION=us-west-2
DATABASE_SECRET_ARN=
ORCHESTRATOR_RUNTIME_ARN=
BIDDER_RUNTIME_ARN=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
PAYMENT_MANAGER_ARN=
PAYMENT_CONNECTOR_ID=
PAYMENT_INSTRUMENT_ID=
PAYMENT_USER_ID=
# Cognito sub of the account permitted to use the existing Stripe/Privy wallet.
PAYMENT_OWNER_SUB=
# Optional URL of your existing Privy wallet-management frontend.
PRIVY_WALLET_URL=
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_TOKEN=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
CHAIN_NETWORK=eip155:84532
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
